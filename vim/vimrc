" Basic Vim config: a plain editor with syntax highlighting, Copilot,
" and EditorConfig support. Neovim (nvim/) is the main editor.

set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set fileformats=unix,dos,mac
set backspace=indent,eol,start
set hidden
set number
set cursorline
set ruler
set showcmd
set scrolloff=3
set laststatus=2
set wildmode=list:longest,full
set mouse=a
set clipboard=unnamedplus
set autoread
set nobackup
set noswapfile
set visualbell t_vb=

set incsearch
set hlsearch
set ignorecase
set smartcase

set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4

let mapleader = ','

noremap <Leader>h :<C-u>split<CR>
noremap <Leader>v :<C-u>vsplit<CR>
noremap <Leader>e :e <C-R>=expand("%:p:h") . "/" <CR>
noremap <Leader>. :lcd %:p:h<CR>
noremap <Leader>sh :terminal<CR>
nnoremap <silent> <Leader><Space> :noh<CR>

noremap <C-j> <C-w>j
noremap <C-k> <C-w>k
noremap <C-l> <C-w>l
noremap <C-h> <C-w>h

noremap <Leader>z :bp<CR>
noremap <Leader>q :bp<CR>
noremap <Leader>x :bn<CR>
noremap <Leader>w :bn<CR>
noremap <Leader>c :bd<CR>

vmap < <gv
vmap > >gv
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

cnoreabbrev W! w!
cnoreabbrev Q! q!
cnoreabbrev Qall! qall!
cnoreabbrev Wq wq
cnoreabbrev Wa wa
cnoreabbrev wQ wq
cnoreabbrev WQ wq
cnoreabbrev W w
cnoreabbrev Q q
cnoreabbrev Qall qall

function! s:HasEditorConfig() abort
    return !empty(findfile('.editorconfig', expand('%:p:h') . ';'))
endfunction

augroup vimrc
    autocmd!
    autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g`\"" | endif
    autocmd BufRead,BufNewFile *.txt setlocal wrap textwidth=79
    autocmd FileType python setlocal colorcolumn=79
    autocmd FileType make,go if !s:HasEditorConfig() | setlocal noexpandtab | endif
    autocmd FileType yaml,helm if !s:HasEditorConfig() | setlocal tabstop=2 softtabstop=2 shiftwidth=2 | endif
augroup END
