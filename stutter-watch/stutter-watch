def find_pid(name: str) -> int | None:
    for entry in Path("/proc").iterdir():
        if entry.name.isdigit() and read_text(entry / "comm") == name:
            return int(entry.name)
    return None


def cgroup_dir(pid: int | None) -> Path | None:
    if not pid:
        return None
    rel = read_text(f"/proc/{pid}/cgroup").rpartition("::")[2]
    path = Path("/sys/fs/cgroup") / rel.lstrip("/")
    return path if rel and path.is_dir() else None


def local_hms(ts: float) -> str:
    return datetime.fromtimestamp(ts).strftime("%H:%M:%S")


def prompts_enabled() -> bool:
    return not PROMPTS_OFF.exists()


def ask(summary: str, body: str, actions: list[tuple[str, str]], timeout_s: int) -> str | None:
    """Notification with buttons; returns the chosen action name, or None if ignored."""
    if not shutil.which("notify-send"):
        return None
    args = ["notify-send", "-a", "stutter-watch", "-u", "normal", "-t", str(timeout_s * 1000)]
    for name, label in actions:
        args += ["-A", f"{name}={label}"]
    args += [summary, body]
    try:
        proc = subprocess.run(args, text=True, capture_output=True, timeout=timeout_s + 10, check=False)
        return proc.stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


YES_NO = [("yes", "Yes, stuttered"), ("no", "No"), ("unsure", "Not sure")]


class PsiTrigger:
    def __init__(self, label: str, path: Path, threshold_us: int):
        self.label, self.path = label, path
        self.fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        try:
            os.write(self.fd, f"some {threshold_us} {PSI_WINDOW_US}\0".encode())
        except OSError:
            os.close(self.fd)
            raise

    def close(self) -> None:
        try:
            os.close(self.fd)
        except OSError:
            pass


class Detector:
    """Runs beside the 5 s sampler.

    * PSI triggers (kernel-notified within ~2 s) on the desktop stack's cgroup,
      Steam's cgroup and system memory. On the desktop a stall episode pops up a
      Yes/No question right away (rate-limited); during a game it is queued.
    * While a game runs, MangoHud's per-frame log is tailed; clusters of slow
      frames become stutter detections.
    * When the game exits, the worst detections are reviewed one notification at a time.
    """

    def __init__(self, events_path: Path):
        self.events_path = events_path
        self.lock = threading.Lock()
        self.triggers: dict[str, PsiTrigger] = {}
        self.arm_errors: set[str] = set()
        self.stall: dict | None = None
        self.session: dict | None = None
        self.last_desktop_prompt = 0.0
        self.desktop_prompt_busy = False
        self.seq = 0

    def log(self, obj: dict) -> None:
        append_json(self.events_path, obj)

    def next_id(self, prefix: str) -> str:
        with self.lock:
            self.seq += 1
            return f"{prefix}-{int(time.time())}-{self.seq}"

    def start(self) -> None:
        FRAMETIMES.mkdir(parents=True, exist_ok=True)
        cutoff = time.time() - FRAMETIME_KEEP_DAYS * 86400
        for f in (f for d in FRAME_DIRS for f in d.glob("*.csv")):
            try:
                if f.stat().st_mtime < cutoff:
                    f.unlink()
            except OSError:
                pass
        for target in (self.psi_loop, self.frame_loop):
            threading.Thread(target=self.guard, args=(target,), daemon=True).start()

    def guard(self, target) -> None:
        # A detector bug must never take the sampler down; log it and stop that thread.
        try:
            target()
        except Exception as exc:  # noqa: BLE001
            self.log({"type": "detector_error", "timestamp": now_iso(), "thread": target.__name__, "error": repr(exc)[:500]})

    # ----- PSI -----
    def desired_triggers(self) -> dict[str, tuple[Path, int]]:
        want = {"global_memory": (Path("/proc/pressure/memory"), PSI_GLOBAL_MEM_US)}
        desk = cgroup_dir(find_pid("Hyprland"))
        if desk:
            want["desktop_cpu"] = (desk / "cpu.pressure", PSI_DESKTOP_US)
            want["desktop_memory"] = (desk / "memory.pressure", PSI_DESKTOP_US)
        game = cgroup_dir(find_pid("steam"))
        if game:
            want["game_cpu"] = (game / "cpu.pressure", PSI_GAME_CPU_US)
            want["game_memory"] = (game / "memory.pressure", PSI_GAME_MEM_US)
        return want

    def rearm(self) -> None:
        want = self.desired_triggers()
        for label in list(self.triggers):
            if label not in want or self.triggers[label].path != want[label][0]:
                self.triggers.pop(label).close()
        for label, (path, threshold) in want.items():
            if label in self.triggers:
                continue
            try:
                self.triggers[label] = PsiTrigger(label, path, threshold)
                self.arm_errors.discard(label)
            except OSError as exc:
                if label not in self.arm_errors:
                    self.arm_errors.add(label)
                    self.log({"type": "sensor_unavailable", "sensor": f"psi_trigger:{label}", "timestamp": now_iso(), "detail": str(exc)[:200]})

    def psi_loop(self) -> None:
        next_resolve = 0.0
        while not STOP:
            now = time.time()
            if now >= next_resolve:
                self.rearm()
                next_resolve = now + 15
            poller = select.poll()
            by_fd = {}
            for trig in self.triggers.values():
                poller.register(trig.fd, select.POLLPRI)
                by_fd[trig.fd] = trig
            for fd, ev in poller.poll(1000):
                trig = by_fd.get(fd)
                if trig is None:
                    continue
                if ev & (select.POLLERR | select.POLLNVAL):
                    self.triggers.pop(trig.label, None)
                    trig.close()  # cgroup went away (e.g. Steam restarted); re-armed on next resolve
                elif ev & select.POLLPRI:
                    self.on_stall(trig.label, time.time())
            self.flush_stall(time.time())
            self.check_game_transition()

    def on_stall(self, label: str, ts: float) -> None:
        with self.lock:
            if self.stall and ts - self.stall["last"] <= 4:
                self.stall["last"] = ts
                self.stall["sources"][label] = self.stall["sources"].get(label, 0) + 1
                return
        self.flush_stall(ts, force=True)
        with self.lock:
            self.stall = {"start": ts, "last": ts, "sources": {label: 1}, "gaming": game_active()}

    def flush_stall(self, now: float, force: bool = False) -> None:
        with self.lock:
            stall = self.stall
            if not stall or (not force and now - stall["last"] <= 4):
                return
            self.stall = None
        ep = {
            "type": "stall_episode", "id": self.next_id("stall"),
            "timestamp": datetime.fromtimestamp(stall["start"], timezone.utc).isoformat(timespec="milliseconds"),
            "start_unix": stall["start"], "duration_s": round(stall["last"] - stall["start"] + PSI_WINDOW_US / 1e6, 1),
            "sources": stall["sources"], "gaming": stall["gaming"],
            "fragmentation_mib_order_ge_9": buddyinfo().get("normal_free_mib_order_ge_9"),
            "pressure": psi(),
        }
        self.log(ep)
        if stall["gaming"]:
            with self.lock:
                if self.session is not None:
                    self.session["stalls"].append(ep)
            return
        desktop = any(s.startswith("desktop") or s == "global_memory" for s in stall["sources"])
        if desktop and prompts_enabled() and not self.desktop_prompt_busy and now - self.last_desktop_prompt >= DESKTOP_PROMPT_COOLDOWN_S:
            self.last_desktop_prompt = now
            self.desktop_prompt_busy = True
            threading.Thread(target=self.desktop_prompt, args=(ep,), daemon=True).start()

    def desktop_prompt(self, ep: dict) -> None:
        try:
            kinds = sorted({"memory" if "memory" in s else "CPU" for s in ep["sources"]})
            answer = ask(
                "Possible stutter just now?",
                f"At {local_hms(ep['start_unix'])} the desktop was held up waiting for {' and '.join(kinds)} "
                f"(~{ep['duration_s']} s). Did you notice a stutter?",
                YES_NO, 45)
            self.log({"type": "stutter_confirmation", "timestamp": now_iso(), "ref": ep["id"], "context": "desktop", "answer": answer or "no_response"})
        finally:
            self.desktop_prompt_busy = False

    # ----- game sessions -----
    def check_game_transition(self) -> None:
        gaming = game_active()
        with self.lock:
            session = self.session
            if gaming and session is None:
                self.session = {"id": self.next_id_unlocked("game"), "start": time.time(), "detections": [], "stalls": [], "logs": set()}
                return
            if gaming or session is None:
                return
            self.session = None
        session["end"] = time.time()
        threading.Thread(target=self.guard, args=(lambda: self.end_session(session),), daemon=True).start()

    def next_id_unlocked(self, prefix: str) -> str:
        self.seq += 1
        return f"{prefix}-{int(time.time())}-{self.seq}"

    def end_session(self, session: dict) -> None:
        time.sleep(8)  # let the frame thread close the last episode
        with self.lock:
            dets = list(session["detections"])
        stalls = session["stalls"]
        # Without a MangoHud log (e.g. MangoHud opted out), fall back to the game's own stalls.
        if not session["logs"]:
            dets = [{"id": s["id"], "start_unix": s["start_unix"], "duration_s": s["duration_s"], "source": "psi", "sources": s["sources"]}
                    for s in stalls if any(k.startswith("game") for k in s["sources"])]
        minutes = round((session["end"] - session["start"]) / 60)
        summary = {"type": "game_session_summary", "timestamp": now_iso(), "id": session["id"], "minutes": minutes,
                   "frame_logs": sorted(session["logs"]), "detections": len(dets), "stall_episodes": len(stalls)}
        self.log(summary)
        if minutes < 2:
            return
        if not dets:
            if prompts_enabled():
                notify("No stutters detected", f"Game session ({minutes} min). Press Super+Shift+M if you noticed one.")
            return
        save_pending({"session": session["id"], "minutes": minutes, "items": dets})
        if prompts_enabled():
            review_items(dets, minutes, self.log)


def severity(d: dict) -> float:
    if d.get("source") == "frametime":
        return d.get("worst_ms", 0) * max(1, d.get("hitches", 1))
    return 100 * d.get("duration_s", 0)


def describe(d: dict) -> str:
    if d.get("source") == "frametime":
        txt = f"{d['duration_s']} s · {d['hitches']} slow frames · worst {d['worst_ms']:.0f} ms (normal {d['median_ms']:.1f} ms)"
        if d.get("long_freeze"):
            txt += "\nIncludes a multi-second freeze (could be a loading screen)."
        return txt
    kinds = sorted({"memory" if "memory" in s else "CPU" for s in d.get("sources", {})})
    return f"~{d['duration_s']} s · game held up waiting for {' and '.join(kinds)}"


def save_pending(obj: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    PENDING_REVIEW.write_text(json.dumps(obj))


def review_items(dets: list, minutes: int, log, intro_timeout: int = 600) -> None:
    worst = max(dets, key=severity)
    choice = ask(
        f"Game session: {len(dets)} suspected stutter{'s' if len(dets) != 1 else ''}",
        f"{minutes} min played. Worst at {local_hms(worst['start_unix'])}: {describe(worst).splitlines()[0]}.\nReview them now?",
        [("review", "Review"), ("later", "Later"), ("skip", "Skip")], intro_timeout)
    log({"type": "review_started", "timestamp": now_iso(), "choice": choice or "no_response", "items": len(dets)})
    if choice != "review":
        if choice == "skip":
            PENDING_REVIEW.unlink(missing_ok=True)
        else:
            notify("Review saved for later", "Run 'stutter-watch review' when convenient.")
        return
    top = sorted(sorted(dets, key=severity, reverse=True)[:REVIEW_MAX_ITEMS], key=lambda d: d["start_unix"])
    for i, d in enumerate(top, 1):
        answer = ask(f"Stutter {i}/{len(top)} at {local_hms(d['start_unix'])}", describe(d) + "\nDid you notice it?", YES_NO, 300)
        log({"type": "stutter_confirmation", "timestamp": now_iso(), "ref": d["id"], "context": "game_review", "answer": answer or "no_response"})
        if answer is None:
            break  # user walked away; keep the rest pending
    else:
        missed = ask("Anything we missed?", "Did you notice stutters that weren't listed?",
                     [("yes", "Yes, there were more"), ("no", "No")], 300)
        log({"type": "review_missed_question", "timestamp": now_iso(), "answer": missed or "no_response"})
        PENDING_REVIEW.unlink(missing_ok=True)
        notify("Thanks — review saved", "")


class FrameEpisodes:
    """Turns a stream of frame times into stutter episodes."""

    def __init__(self):
        self.recent: list[float] = []
        self.median: float | None = None
        self.since_median = 0
        self.ep: dict | None = None

    def feed(self, t: float, ft: float) -> dict | None:
        """t = wall time of the frame; returns a finished episode (if one closed)."""
        done = None
        if self.ep and t - self.ep["last"] > EPISODE_GAP_S:
            done = self.close()
        med = self.median
        if med is not None and ft >= HITCH_MIN_MS and ft >= HITCH_FACTOR * med:
            if self.ep is None:
                self.ep = {"start": t - ft / 1000, "last": t, "hitches": 0, "worst": 0.0, "median": med, "long_freeze": False}
            self.ep["last"] = t
            self.ep["hitches"] += 1
            self.ep["worst"] = max(self.ep["worst"], ft)
            if ft >= 2000:
                self.ep["long_freeze"] = True
            return done
        # Normal frame: update the baseline (hitches are kept out of it).
        self.recent.append(ft)
        if len(self.recent) > 600:
            del self.recent[:-600]
        self.since_median += 1
        if len(self.recent) >= 60 and (med is None or self.since_median >= 30):
            s = sorted(self.recent)
            self.median = s[len(s) // 2]
            self.since_median = 0
        return done

    def close(self) -> dict | None:
        ep, self.ep = self.ep, None
        if not ep or (ep["hitches"] < EPISODE_MIN_HITCHES and ep["worst"] < EPISODE_BIG_HITCH_MS):
            return None
        return ep


def mangohud_log_start(path: Path) -> float | None:
    m = re.search(r"_(\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2})\.csv$", path.name)
    if not m:
        return None
    try:
        return datetime.strptime(m.group(1), "%Y-%m-%d_%H-%M-%S").timestamp()
    except ValueError:
        return None


def _detector_frame_loop(self: Detector) -> None:
    current: Path | None = None
    fh = None
    partial = ""
    episodes = FrameEpisodes()
    log_start = None
    last_growth = time.time()
    exe = ""

    def finish(ep: dict | None) -> None:
        if not ep:
            return
        det = {"type": "stutter_detected", "id": self.next_id("frames"), "source": "frametime",
               "timestamp": datetime.fromtimestamp(ep["start"], timezone.utc).isoformat(timespec="milliseconds"),
               "start_unix": ep["start"], "duration_s": round(ep["last"] - ep["start"], 1),
               "hitches": ep["hitches"], "worst_ms": round(ep["worst"], 1), "median_ms": round(ep["median"], 2),
               "long_freeze": ep["long_freeze"], "exe": exe,
               "fragmentation_mib_order_ge_9": buddyinfo().get("normal_free_mib_order_ge_9")}
        self.log(det)
        with self.lock:
            if self.session is not None:
                self.session["detections"].append(det)

    while not STOP:
        now = time.time()
        newest = None
        try:
            logs = [p for d in FRAME_DIRS for p in d.glob("*.csv") if now - p.stat().st_mtime < 15]
            newest = max(logs, key=lambda p: p.stat().st_mtime) if logs else None
            # Stick with the log being followed while it is still live: an app with two
            # Vulkan processes writes two logs at once and would otherwise flip-flop.
            if current is not None and current in logs:
                newest = current
        except OSError:
            pass
        if newest is not None and newest != current:
            if fh:
                fh.close()
            finish(episodes.close())
            current, fh, partial, episodes = newest, newest.open("r", errors="replace"), "", FrameEpisodes()
            log_start = mangohud_log_start(newest) or now
            exe = newest.name.rsplit("_", 2)[0][:60]
            last_growth = now
            with self.lock:
                if self.session is not None:
                    self.session["logs"].add(newest.name)
        if fh:
            chunk = fh.read()
            if chunk:
                last_growth = now
                lines = (partial + chunk).split("\n")
                partial = lines.pop()
                for line in lines:
                    cols = line.split(",")
                    if len(cols) < 3:
                        continue
                    try:
                        ft = float(cols[1])
                        elapsed = float(cols[-1]) / 1e9
                    except ValueError:
                        continue  # header lines
                    if elapsed < LOG_WARMUP_S:
                        continue
                    finish(episodes.feed(log_start + elapsed, ft))
            elif now - last_growth > 5:
                finish(episodes.close())  # game ended or paused logging
                if now - last_growth > 15:
                    fh.close()
                    fh, current = None, None
        time.sleep(0.5)


Detector.frame_loop = _detector_frame_loop


def review_command() -> int:
