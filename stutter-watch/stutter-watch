def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def read_text(path: str | Path, default: str = "") -> str:
    try:
        return Path(path).read_text(errors="replace").strip()
    except (OSError, ValueError):
        return default


def read_int(path: str | Path) -> int | None:
    text = read_text(path)
    try:
        return int(text)
    except (TypeError, ValueError):
        return None


def command(args: list[str], timeout: float = 3.0) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)


def unit_names(output: str) -> list[str]:
    names = []
    for line in output.splitlines():
        for token in line.split():
            if token.endswith((".service", ".socket", ".target", ".timer", ".mount", ".scope")):
                names.append(token)
                break
    return names


def json_command(args: list[str], timeout: float = 2.0):
    rc, out, err = command(args, timeout)
    if rc == 0:
        try:
            return json.loads(out), None
        except json.JSONDecodeError as exc:
            return None, f"invalid JSON: {exc}"
    return None, err or f"exit status {rc}"


def append_json(path: Path, obj: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(obj, separators=(",", ":"), ensure_ascii=False) + "\n")
        f.flush()
        fcntl.flock(f, fcntl.LOCK_UN)


def session_dir() -> Path | None:
    sid = read_text(ACTIVE)
    if not sid or "/" in sid or sid.startswith("."):
        return None
    path = SESSIONS / sid
    return path if path.is_dir() else None


def load_manifest(path: Path) -> dict:
    try:
        return json.loads((path / "manifest.json").read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_manifest(path: Path, manifest: dict) -> None:
    tmp = path / "manifest.json.tmp"
    tmp.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(path / "manifest.json")


def start_session() -> Path:
    SESSIONS.mkdir(parents=True, exist_ok=True)
    sid = datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
    path = SESSIONS / sid
    path.mkdir()
    now = time.time()
    guide = HOME / ".local/share/doc/stutter-watch/README.md"
    if guide.is_file():
        shutil.copyfile(guide, path / "README.md")
    manifest = {
        "session_id": sid,
        "started_at": now_iso(),
        "started_unix": now,
        "deadline_unix": now + DURATION_SECONDS,
        "duration_seconds": DURATION_SECONDS,
        "sample_interval_seconds": SAMPLE_SECONDS,
        "status": "recording",
        "privacy": "No command-line arguments, document contents, or network payloads are recorded. Process names, PIDs, cgroup unit names, hardware metrics, and selected kernel warnings are recorded.",
    }
    save_manifest(path, manifest)
    ACTIVE.write_text(sid + "\n")
    append_json(path / "events.jsonl", {"type": "session_started", "timestamp": now_iso(), "deadline_unix": manifest["deadline_unix"]})
    return path


def statvfs(path: str) -> dict | None:
    try:
        st = os.statvfs(path)
        unit = st.f_frsize
        return {"total_bytes": st.f_blocks * unit, "free_bytes": st.f_bavail * unit, "used_bytes": (st.f_blocks - st.f_bfree) * unit}
    except OSError:
        return None


def inventory() -> dict:
    release = {}
    for line in read_text("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            release[k] = v.strip('"')
    cpu_model = ""
    for line in read_text("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            cpu_model = line.partition(":")[2].strip()
            break
    block_devices = {}
    for dev in Path("/sys/block").glob("*"):
        name = dev.name
        if name.startswith(("loop", "ram")):
            continue
        block_devices[name] = {
            "model": read_text(dev / "device/model") or read_text(dev / "device/name") or None,
            "size_512_sectors": read_int(dev / "size"),
            "rotational": read_int(dev / "queue/rotational"),
            "device_mapper_name": read_text(dev / "dm/name") or None,
        }
    gpus = []
    for card in Path("/sys/class/drm").glob("card[0-9]*"):
        if not re.fullmatch(r"card\d+", card.name):
            continue
        device = card / "device"
        try:
            driver = (device / "driver").resolve().name
        except OSError:
            driver = None
        gpus.append({
            "card": card.name,
            "driver": driver,
            "vendor_id": read_text(device / "vendor") or None,
            "device_id": read_text(device / "device") or None,
            "pci_slot": device.resolve().name,
        })
    mounts = []
    try:
        for line in Path("/proc/mounts").read_text().splitlines():
            cols = line.split()
            if len(cols) >= 4 and (cols[2] == "btrfs" or cols[1] in ("/", "/home", "/var/cache", "/var/log", "/var/tmp")):
                mounts.append({"source": cols[0], "target": cols[1], "fstype": cols[2], "options": cols[3]})
    except OSError:
        pass
    services = {"system": [], "user": []}
    timers = {"system": [], "user": []}
    for scope in services:
        args = ["systemctl"] + (["--user"] if scope == "user" else []) + ["list-units", "--type=service", "--state=running", "--no-legend", "--no-pager"]
        rc, out, _ = command(args, 5)
        if rc == 0:
            services[scope] = [line.split()[0] for line in out.splitlines() if line.split()]
        args = ["systemctl"] + (["--user"] if scope == "user" else []) + ["list-timers", "--all", "--no-legend", "--no-pager"]
        rc, out, _ = command(args, 5)
        if rc == 0:
            timers[scope] = [line.strip() for line in out.splitlines() if line.strip()]
    failed = {}
    for scope in ("system", "user"):
        args = ["systemctl"] + (["--user"] if scope == "user" else []) + ["--failed", "--no-legend", "--no-pager"]
        rc, out, _ = command(args, 5)
        failed[scope] = unit_names(out) if rc == 0 else None
    packages = {}
    if shutil.which("pacman"):
        names = ["linux-cachyos", "mesa", "intel-gpu-tools", "gputop", "btrfs-progs", "zram-generator", "power-profiles-daemon", "intel-lpmd", "ananicy-cpp", "scx-scheds"]
        rc, out, _ = command(["pacman", "-Q", *names], 8)
        if out:
            packages = {line.split()[0]: line.split()[1] for line in out.splitlines() if len(line.split()) >= 2}
    variety_conf = {}
    for line in read_text(HOME / ".config/variety/variety.conf").splitlines():
        if line.startswith(("change_enabled =", "change_interval =", "wallpaper_auto_rotate =", "stats_enabled =")):
            key, _, val = line.partition("=")
            variety_conf[key.strip()] = val.strip()
    btrfs = {}
    for key, args in {
        "device_stats": ["btrfs", "device", "stats", "/"],
        "filesystem_usage": ["btrfs", "filesystem", "usage", "-b", "/"],
    }.items():
        rc, out, err = command(args, 8)
        btrfs[key] = out if rc == 0 else (out + ("\n" + err if err else ""))
    return {
        "captured_at": now_iso(),
        "hostname": platform.node(),
        "os": release,
        "kernel": platform.release(),
        "architecture": platform.machine(),
        "cpu_model": cpu_model,
        "logical_cpu_count": CPU_COUNT,
        "boot_id": read_text("/proc/sys/kernel/random/boot_id"),
        "block_devices": block_devices,
        "gpus": gpus,
        "mounts": mounts,
        "running_services": services,
        "scheduled_timers": timers,
        "failed_services": failed,
        "packages": packages,
        "variety_config": variety_conf,
        "btrfs_baseline": btrfs,
        "gpu_tools": {name: shutil.which(name) for name in ("gputop", "intel_gpu_top")},
        "privacy_note": "Process command lines and file contents are not collected. Current wallpaper is recorded by basename and file metadata only.",
    }


def parse_proc_stat() -> dict:
    out = {"cpus": {}, "misc": {}}
    try:
        lines = Path("/proc/stat").read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        fields = line.split()
        if not fields:
            continue
        if re.fullmatch(r"cpu\d*", fields[0]):
            vals = [int(x) for x in fields[1:]]
            out["cpus"][fields[0]] = vals
        elif fields[0] in ("ctxt", "intr", "softirq", "processes", "procs_running", "procs_blocked"):
            try:
                out["misc"][fields[0]] = int(fields[1])
            except (IndexError, ValueError):
                pass
    return out


def cpu_percentages(cur: dict, prev: dict | None) -> dict:
    if not prev:
        return {}
    result = {}
    for name, vals in cur["cpus"].items():
        old = prev.get("cpus", {}).get(name)
        if not old or len(vals) < 8:
            continue
        n = min(len(vals), len(old))
        delta = [max(0, vals[i] - old[i]) for i in range(n)]
        # Guest and guest_nice are already included in user and nice.
        total = sum(delta[:8])
        if not total:
            continue
        keys = ("user", "nice", "system", "idle", "iowait", "irq", "softirq", "steal", "guest", "guest_nice")
        result[name] = {keys[i]: round(100 * delta[i] / total, 2) for i in range(min(n, len(keys)))}
    return result


def meminfo() -> dict:
    out = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, _, rest = line.partition(":")
            vals = rest.split()
            if vals:
                out[key] = int(vals[0]) * (1024 if len(vals) > 1 and vals[1] == "kB" else 1)
    except (OSError, ValueError):
        pass
    return out


def vmstat() -> dict:
    out = {}
    try:
        for line in Path("/proc/vmstat").read_text().splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[0] in {
                "pswpin", "pswpout", "pgmajfault", "pgfault", "pgscan_kswapd", "pgscan_direct",
                "pgsteal_kswapd", "pgsteal_direct", "compact_stall", "compact_fail", "oom_kill",
                "compact_success", "compact_daemon_wake", "allocstall_normal", "allocstall_movable",
                "thp_fault_alloc", "thp_fault_fallback", "thp_collapse_alloc",
                "workingset_refault_anon", "workingset_refault_file",
            }:
                out[fields[0]] = int(fields[1])
    except (OSError, ValueError):
        pass
    return out


def psi() -> dict:
    result = {}
    for resource in ("cpu", "memory", "io"):
        data = {}
        try:
            for line in Path(f"/proc/pressure/{resource}").read_text().splitlines():
                fields = line.split()
                if fields:
                    key = fields[0]
                    vals = {}
                    for part in fields[1:]:
                        if "=" in part:
                            k, v = part.split("=", 1)
                            try:
                                vals[k] = float(v) if k.startswith("avg") else int(v)
                            except ValueError:
                                pass
                    data[key] = vals
        except OSError:
            pass
        if data:
            result[resource] = data
    return result


def diskstats() -> dict:
    result = {}
    try:
        lines = Path("/proc/diskstats").read_text().splitlines()
    except OSError:
        return result
    for line in lines:
        fields = line.split()
        if len(fields) < 14:
            continue
        name = fields[2]
        if name.startswith(("loop", "ram")):
            continue
        try:
            values = [int(x) for x in fields[3:14]]
        except ValueError:
            continue
        result[name] = {
            "reads_completed": values[0], "sectors_read_512": values[2], "read_ms": values[3],
            "writes_completed": values[4], "sectors_written_512": values[6], "write_ms": values[7],
            "io_in_progress": values[8], "io_ms": values[9], "weighted_io_ms": values[10],
        }
    return result


def disk_rates(cur: dict, prev: dict | None, dt: float) -> dict:
    if not prev or dt <= 0:
        return {}
    result = {}
    for name, val in cur.items():
        old = prev.get(name)
        if not old:
            continue
        def rate(key, factor=1.0):
            return round(max(0, val[key] - old.get(key, val[key])) * factor / dt, 3)
        result[name] = {
            "read_bytes_per_sec": rate("sectors_read_512", 512),
            "write_bytes_per_sec": rate("sectors_written_512", 512),
            "reads_per_sec": rate("reads_completed"), "writes_per_sec": rate("writes_completed"),
            "io_ms_per_sec": rate("io_ms"), "weighted_io_ms_per_sec": rate("weighted_io_ms"),
            "in_progress": val["io_in_progress"],
        }
    return result


def process_snapshot() -> dict:
    result = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            raw = (entry / "stat").read_text()
            close = raw.rfind(")")
            if close < 0:
                continue
            name = raw[raw.find("(") + 1:close]
            fields = raw[close + 2:].split()  # begins at proc stat field 3 (state)
            if len(fields) < 22:
                continue
            state = fields[0]
            cpu_ticks = int(fields[11]) + int(fields[12])
            start_ticks = int(fields[19])
            rss = max(0, int(fields[21])) * PAGE_SIZE
            io = {}
            try:
                for line in (entry / "io").read_text().splitlines():
                    key, _, value = line.partition(":")
                    if key in ("read_bytes", "write_bytes"):
                        io[key] = int(value.strip())
            except (OSError, ValueError):
                pass
            cgroup = ""
            try:
                cg = (entry / "cgroup").read_text().splitlines()
                if cg:
                    cgroup = cg[-1].rsplit(":", 1)[-1].rsplit("/", 1)[-1][:100]
            except OSError:
                pass
            result[str(pid)] = {"name": name[:80], "state": state, "cpu_ticks": cpu_ticks, "start_ticks": start_ticks, "rss_bytes": rss, "io": io, "cgroup": cgroup}
        except (OSError, ValueError, ProcessLookupError):
            continue
    return result


def process_top(cur: dict, prev: dict | None, dt: float, limit: int = 10) -> list:
    rows = []
    for pid, proc in cur.items():
        old = (prev or {}).get(pid)
        if not old or old.get("start_ticks") != proc["start_ticks"]:
            continue
        cpu_ticks = max(0, proc["cpu_ticks"] - old["cpu_ticks"])
        cpu_one = 100 * cpu_ticks / HZ / max(dt, 0.001)
        io = proc.get("io", {})
        old_io = old.get("io", {})
        read_bps = max(0, io.get("read_bytes", 0) - old_io.get("read_bytes", 0)) / max(dt, 0.001)
        write_bps = max(0, io.get("write_bytes", 0) - old_io.get("write_bytes", 0)) / max(dt, 0.001)
        if cpu_one > 0.05 or read_bps + write_bps > 4096:
            rows.append({
                "pid": int(pid), "name": proc["name"], "state": proc["state"], "cgroup": proc["cgroup"],
                "cpu_pct_one_core": round(cpu_one, 2), "cpu_pct_machine": round(cpu_one / CPU_COUNT, 2),
                "rss_bytes": proc["rss_bytes"], "read_bytes_per_sec": round(read_bps),
                "write_bytes_per_sec": round(write_bps),
            })
    rows.sort(key=lambda p: (p["cpu_pct_one_core"] * 10 + (p["read_bytes_per_sec"] + p["write_bytes_per_sec"]) / 1e6), reverse=True)
    return rows[:limit]


def process_top_rss(cur: dict, limit: int = 8) -> list:
    rows = [
        {"pid": int(pid), "name": proc["name"], "state": proc["state"], "cgroup": proc["cgroup"], "rss_bytes": proc["rss_bytes"]}
        for pid, proc in cur.items() if proc["rss_bytes"] > 1024 * 1024
    ]
    rows.sort(key=lambda proc: proc["rss_bytes"], reverse=True)
    return rows[:limit]


def zram_stats() -> dict:
    base = Path("/sys/block/zram0")
    result = {}
    for file, keys in (("mm_stat", ("orig_data_bytes", "compressed_data_bytes", "mem_used_total_bytes", "mem_limit_bytes", "mem_used_max_bytes", "same_pages", "pages_compacted", "huge_pages", "huge_pages_since")),
                       ("io_stat", ("failed_reads", "failed_writes", "invalid_io", "notify_free")),
                       ("bd_stat", ("backing_reads", "backing_writes", "backing_read_bytes", "backing_write_bytes"))):
        vals = read_text(base / file).split()
        if vals:
            item = {}
            for i, key in enumerate(keys):
                try:
                    item[key] = int(vals[i])
                except (IndexError, ValueError):
                    break
            result[file] = item
    result["disksize_bytes"] = read_int(base / "disksize")
    result["algorithm"] = read_text(base / "comp_algorithm")
    return result


def sensor_values() -> dict:
    result = {}
    for hwmon in Path("/sys/class/hwmon").glob("hwmon*"):
        name = read_text(hwmon / "name", hwmon.name)
        for pattern in ("temp*_input", "fan*_input", "power*_average"):
            for sensor in hwmon.glob(pattern):
                val = read_int(sensor)
                if val is None:
                    continue
                stem = sensor.name.rsplit("_", 1)[0]
                label = read_text(hwmon / f"{stem}_label") or stem
                result[f"{name}.{label}"] = val
    return result


def nvme_sysfs() -> dict:
    result = {}
    keys = ("model", "firmware_rev", "serial", "state", "current_link_speed", "current_link_width", "critical_warning", "temperature", "temperature_sensor_1", "temperature_sensor_2", "warning_temp_time", "critical_comp_time", "unsafe_shutdowns", "media_errors", "num_err_log_entries", "data_units_read", "data_units_written", "host_reads", "host_writes", "power_cycles", "power_on_hours")
    # Serial numbers are deliberately excluded; other health counters are useful and usually world-readable.
    for dev in Path("/sys/class/nvme").glob("nvme*"):
        item = {}
        for key in keys:
            if key == "serial":
                continue
            value = read_text(dev / key)
            if value:
                try:
                    item[key] = int(value, 0)
                except ValueError:
                    item[key] = value
        if item:
            result[dev.name] = item
    return result


def cpu_power_state() -> dict:
    result = {
        "policies": {}, "intel_pstate": {},
        "sched_ext": {
            "state": read_text("/sys/kernel/sched_ext/state") or None,
            "scheduler": read_text("/sys/kernel/sched_ext/root/ops") or None,
        },
    }
    if shutil.which("powerprofilesctl"):
        rc, profile, _ = command(["powerprofilesctl", "get"], 1)
        result["power_profile"] = profile if rc == 0 else None
    for policy in Path("/sys/devices/system/cpu/cpufreq").glob("policy*"):
        fields = ("scaling_driver", "scaling_governor", "energy_performance_preference", "scaling_min_freq", "scaling_max_freq", "scaling_cur_freq", "cpuinfo_min_freq", "cpuinfo_max_freq", "cpuinfo_cur_freq")
        result["policies"][policy.name] = {key: (read_int(policy / key) if key.endswith("freq") else read_text(policy / key) or None) for key in fields if (policy / key).exists()}
    for key in ("status", "no_turbo", "hwp_dynamic_boost", "min_perf_pct", "max_perf_pct"):
        value = read_text(Path("/sys/devices/system/cpu/intel_pstate") / key)
        if value:
            result["intel_pstate"][key] = value
    for rapl in Path("/sys/class/powercap").glob("intel-rapl*"):
        if not rapl.is_dir():
            continue
        name = read_text(rapl / "name", rapl.name)
        energy = read_int(rapl / "energy_uj")
        max_energy = read_int(rapl / "max_energy_range_uj")
        if energy is not None:
            result.setdefault("rapl_energy_uj", {})[name] = {"energy_uj": energy, "max_range_uj": max_energy}
    return result


def kernel_tunables() -> dict:
    paths = {
        "vm.swappiness": "/proc/sys/vm/swappiness",
        "vm.page-cluster": "/proc/sys/vm/page-cluster",
        "vm.dirty_background_bytes": "/proc/sys/vm/dirty_background_bytes",
        "vm.dirty_bytes": "/proc/sys/vm/dirty_bytes",
        "vm.dirty_ratio": "/proc/sys/vm/dirty_ratio",
        "vm.dirty_background_ratio": "/proc/sys/vm/dirty_background_ratio",
        "vm.vfs_cache_pressure": "/proc/sys/vm/vfs_cache_pressure",
        "vm.watermark_scale_factor": "/proc/sys/vm/watermark_scale_factor",
        "vm.compaction_proactiveness": "/proc/sys/vm/compaction_proactiveness",
        "thp.enabled": "/sys/kernel/mm/transparent_hugepage/enabled",
        "thp.defrag": "/sys/kernel/mm/transparent_hugepage/defrag",
        "lru_gen.enabled": "/sys/kernel/mm/lru_gen/enabled",
    }
    return {key: value for key, path in paths.items() if (value := read_text(path))}


def battery_state() -> dict:
    result = {}
    for path in Path("/sys/class/power_supply").glob("*"):
        kind = read_text(path / "type")
        if kind not in ("Battery", "Mains", "USB", "USB_C"):
            continue
        item = {key: read_text(path / key) for key in ("status", "capacity", "capacity_level", "online", "voltage_now", "current_now", "power_now", "energy_now", "energy_full", "charge_now", "charge_full")}
        result[path.name] = {k: v for k, v in item.items() if v}
    return result


def wallpaper_state() -> dict:
    paths = [HOME / ".config/hypr/current_wallpaper", HOME / ".config/variety/wallpaper/wallpaper.jpg"]
    result = {}
    for p in paths:
        if not p.exists() and not p.is_symlink():
            continue
        try:
            target = p.resolve(strict=True)
            st = target.stat()
            result[str(p.name)] = {"target_basename": target.name, "size_bytes": st.st_size, "mtime_ns": st.st_mtime_ns}
        except OSError:
            result[str(p.name)] = {"target_basename": None}
    return result


def hypr_env() -> dict:
    """Environment for hyprctl with the *current* Hyprland instance.

    The user service inherits HYPRLAND_INSTANCE_SIGNATURE once at start; after a
    Hyprland restart that value is stale and every hyprctl call fails. Resolve
    the newest live instance each time.
    """
    env = dict(os.environ)
    best = None
    for sock in (RUNTIME_DIR / "hypr").glob("*/.socket.sock"):
        try:
            mtime = sock.parent.stat().st_mtime
        except OSError:
            continue
        if best is None or mtime > best[0]:
            best = (mtime, sock.parent.name)
    if best:
        env["HYPRLAND_INSTANCE_SIGNATURE"] = best[1]
    env.setdefault("XDG_RUNTIME_DIR", str(RUNTIME_DIR))
    return env


def hyprctl(args: list[str], timeout: float = 2.0) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(["hyprctl", *args], text=True, capture_output=True, timeout=timeout, check=False, env=hypr_env())
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)


def hyprctl_json(args: list[str], timeout: float = 2.0):
    rc, out, err = hyprctl(["-j", *args], timeout)
    if rc == 0:
        try:
            return json.loads(out), None
        except json.JSONDecodeError as exc:
            return None, f"invalid JSON: {exc}"
    return None, err or out[:200] or f"exit status {rc}"


def hyprland_layout() -> dict | None:
    """Window/workspace counts (no titles) to test 'more windows -> more stutter'."""
    clients, _ = hyprctl_json(["clients"])
    workspaces, _ = hyprctl_json(["workspaces"])
    if clients is None and workspaces is None:
        return None
    out = {}
    if isinstance(clients, list):
        out["clients"] = len(clients)
        out["clients_hidden"] = sum(1 for c in clients if c.get("hidden"))
        out["clients_floating"] = sum(1 for c in clients if c.get("floating"))
        out["clients_xwayland"] = sum(1 for c in clients if c.get("xwayland"))
    if isinstance(workspaces, list):
        out["workspaces"] = len(workspaces)
    return out


def buddyinfo() -> dict:
    """Free page blocks per order (0..10) for each zone; order 9 = 2 MiB, 10 = 4 MiB."""
    result = {}
    for line in read_text("/proc/buddyinfo").splitlines():
        fields = line.split()
        if len(fields) > 4 and fields[2] == "zone":
            try:
                counts = [int(x) for x in fields[4:]]
            except ValueError:
                continue
            result[fields[3]] = counts
    normal = result.get("Normal")
    if normal:
        # Free memory available as >=2 MiB contiguous blocks; low values = fragmented.
        result["normal_free_mib_order_ge_9"] = round(sum(n * (4096 << o) for o, n in enumerate(normal) if o >= 9) / 1048576, 1)
        result["normal_free_mib_total"] = round(sum(n * (4096 << o) for o, n in enumerate(normal)) / 1048576, 1)
    return result


def proc_swap_rss(pid: int) -> dict:
    out = {}
    for line in read_text(f"/proc/{pid}/status").splitlines():
        key, _, rest = line.partition(":")
        if key in ("VmRSS", "VmSwap"):
            try:
                out[key] = int(rest.split()[0]) * 1024
            except (IndexError, ValueError):
                pass
    return out


def desktop_procs(cur: dict, prev: dict | None, dt: float) -> list:
    rows = []
    for pid, proc in cur.items():
        if proc["name"] not in DESKTOP_PROCS:
            continue
        old = (prev or {}).get(pid)
        cpu = None
        if old and old.get("start_ticks") == proc["start_ticks"]:
            cpu = round(100 * max(0, proc["cpu_ticks"] - old["cpu_ticks"]) / HZ / max(dt, 0.001), 2)
        mem = proc_swap_rss(int(pid))
        rows.append({"pid": int(pid), "name": proc["name"], "cpu_pct_one_core": cpu,
                     "rss_bytes": mem.get("VmRSS", proc["rss_bytes"]), "swap_bytes": mem.get("VmSwap")})
    return rows


def game_active() -> bool:
    """True while the game-performance wrapper holds its shared lock."""
    try:
        with GAME_LOCK.open("r") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(f, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


def hyprland_state() -> tuple[dict | None, str | None]:
    if not shutil.which("hyprctl"):
