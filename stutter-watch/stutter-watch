def prompts_command(state: str) -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    if state == "off":
        PROMPTS_OFF.touch()
    elif state == "on":
        PROMPTS_OFF.unlink(missing_ok=True)
    print(f"Prompts are {'on' if prompts_enabled() else 'off'} (detections are logged either way).")
    return 0


def signal_handler(_signum, _frame):
    global STOP
    STOP = True


def run_recorder() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("stutter-watch is already running", file=sys.stderr)
            return 1
        path = session_dir()
        if path is None:
            path = start_session()
        manifest = load_manifest(path)
        if manifest.get("status") == "complete":
            return 0
        if not manifest:
            print(f"Invalid session manifest at {path}", file=sys.stderr)
            return 1
        if time.time() >= manifest.get("deadline_unix", 0):
            manifest.update({"status": "complete", "finished_at": now_iso(), "finish_reason": "seven-day deadline reached"})
            save_manifest(path, manifest)
            append_json(path / "events.jsonl", {"type": "session_completed", "timestamp": now_iso(), "reason": "seven-day deadline reached"})
            return 0

        events_path = path / "events.jsonl"
        samples_path = path / "samples.jsonl"
        if not (path / "inventory.json").exists():
            inv = inventory()
            tmp = path / "inventory.json.tmp"
            tmp.write_text(json.dumps(inv, indent=2, ensure_ascii=False) + "\n")
            tmp.replace(path / "inventory.json")
            append_json(events_path, {"type": "inventory_captured", "timestamp": now_iso()})
        else:
            inv = json.loads((path / "inventory.json").read_text())

        boot_id = read_text("/proc/sys/kernel/random/boot_id")
        append_json(events_path, {"type": "recorder_started", "timestamp": now_iso(), "boot_id": boot_id, "resumed": bool(manifest.get("last_recorder_start"))})
        manifest["last_recorder_start"] = now_iso()
        manifest["status"] = "recording"
        save_manifest(path, manifest)
        print(f"Recording to {path} (5-second samples; seven-day session)", flush=True)

        previous_stat = None
        previous_proc = None
        previous_vm = None
        previous_power = None
        previous_wallpaper = None
        previous_disks = None
        previous_gpu = None
        previous_monitors = None
        previous_services = None
        previous_btrfs = None
        previous_layout = None
        previous_gaming = None
        journal_time = time.time() - 2
        variety_offset = None
        last_gpu = last_monitor = last_btrfs = last_usage = last_service = last_journal = 0.0
        last_fsync = time.monotonic()
        previous_sample_time = None
        last_boot = boot_id
        sample_file = samples_path.open("a", encoding="utf-8", buffering=1024 * 1024)

        # If resuming the same session, avoid fabricated rate deltas on first sample.
        signal.signal(signal.SIGTERM, signal_handler)
        signal.signal(signal.SIGINT, signal_handler)
        Detector(events_path).start()
        while not STOP:
            tick_start = time.monotonic()
            now = time.time()
            if now >= manifest["deadline_unix"]:
                manifest.update({"status": "complete", "finished_at": now_iso(), "finish_reason": "seven-day deadline reached"})
                save_manifest(path, manifest)
                append_json(events_path, {"type": "session_completed", "timestamp": now_iso(), "reason": "seven-day deadline reached"})
                break
            current_boot = read_text("/proc/sys/kernel/random/boot_id")
            if current_boot != last_boot:
                append_json(events_path, {"type": "boot_changed", "timestamp": now_iso(), "old_boot_id": last_boot, "new_boot_id": current_boot})
                last_boot = current_boot
                previous_stat = previous_proc = previous_vm = previous_power = previous_disks = None
                previous_sample_time = None

            if now - last_gpu >= 15:
                new_gpu, gpu_error = gpu_state()
                if new_gpu is not None:
                    previous_gpu = new_gpu
                    if manifest.pop("gpu_error_recorded", False):
                        append_json(events_path, {"type": "sensor_recovered", "sensor": "gputop", "timestamp": now_iso()})
                        save_manifest(path, manifest)
                elif gpu_error and not manifest.get("gpu_error_recorded"):
                    append_json(events_path, {"type": "sensor_unavailable", "sensor": "gputop", "timestamp": now_iso(), "detail": gpu_error})
                    manifest["gpu_error_recorded"] = True
                    save_manifest(path, manifest)
                last_gpu = now
            if now - last_monitor >= 15:
                new_monitors, monitor_error = hyprland_state()
                if new_monitors is not None:
                    if previous_monitors is not None and monitor_configuration(new_monitors) != monitor_configuration(previous_monitors):
                        append_json(events_path, {"type": "monitor_configuration_change", "timestamp": now_iso(), "before": previous_monitors, "after": new_monitors})
                    previous_monitors = new_monitors
                    previous_layout = hyprland_layout()
                    if manifest.pop("hyprctl_error_recorded", False):
                        append_json(events_path, {"type": "sensor_recovered", "sensor": "hyprctl", "timestamp": now_iso()})
                        save_manifest(path, manifest)
                elif monitor_error and not manifest.get("hyprctl_error_recorded"):
                    append_json(events_path, {"type": "sensor_unavailable", "sensor": "hyprctl", "timestamp": now_iso(), "detail": monitor_error})
                    manifest["hyprctl_error_recorded"] = True
                    save_manifest(path, manifest)
                last_monitor = now
                # Safety net: if a probe process died before restoring blur, restore it here.
                restore_stale_probe(events_path)
            gaming = game_active()
            if previous_gaming is not None and gaming != previous_gaming:
                append_json(events_path, {"type": "game_started" if gaming else "game_ended", "timestamp": now_iso()})
            previous_gaming = gaming
            if now - last_btrfs >= 60:
                previous_btrfs = btrfs_stats()
                last_btrfs = now
            current_services = previous_services
            if now - last_service >= 300:
                current_services = service_state()
                if previous_services is not None and current_services != previous_services:
                    append_json(events_path, {"type": "service_state_change", "timestamp": now_iso(), "before": previous_services, "after": current_services})
                elif previous_services is None:
                    append_json(events_path, {"type": "service_state_snapshot", "timestamp": now_iso(), "state": current_services})
                previous_services = current_services
                last_service = now

            row, disk_ref, current_stat, current_proc, current_vm, current_power, current_wallpaper = sample(
                previous_disks,
                previous_stat,
                previous_sample_time,
                previous_proc,
                previous_vm,
                previous_power,
                previous_wallpaper,
                now,
                previous_gpu,
                previous_monitors,
                previous_btrfs,
                previous_layout,
                gaming,
            )
            if previous_stat is None:
                row["cpu_pct"] = {}
            if previous_disks is None:
                row["disk_rates"] = {}
            if previous_power is None:
                row.pop("rapl_watts", None)
            sample_file.write(json.dumps(row, separators=(",", ":"), ensure_ascii=False) + "\n")
            if row.get("wallpaper_changed"):
                append_json(events_path, {"type": "wallpaper_changed", "timestamp": row["timestamp"], "wallpaper": current_wallpaper})
            if previous_power is not None and current_power != previous_power:
                # Ignore telemetry-only frequency/energy readings; keep actual
                # governor, policy, power-profile, and scheduler changes.
                def control_state(value):
                    v = dict(value)
                    v.pop("rapl_energy_uj", None)
                    for policy in v.get("policies", {}).values():
                        policy.pop("scaling_cur_freq", None)
                        policy.pop("cpuinfo_cur_freq", None)
                    return v
                if control_state(current_power) != control_state(previous_power):
                    append_json(events_path, {"type": "power_scheduler_state_change", "timestamp": row["timestamp"], "before": control_state(previous_power), "after": control_state(current_power)})
            if now - last_usage >= 600:
                usage = btrfs_usage()
                if usage:
                    append_json(events_path, {"type": "btrfs_usage_snapshot", "timestamp": now_iso(), "output": usage})
                last_usage = now
            if now - last_journal >= 30:
                lines, error = kernel_events(journal_time)
                journal_time = now
                if lines:
                    append_json(events_path, {"type": "kernel_log_events", "timestamp": now_iso(), "lines": lines})
                if error and not manifest.get("journal_error_recorded"):
                    append_json(events_path, {"type": "sensor_unavailable", "sensor": "kernel_journal", "timestamp": now_iso(), "detail": error})
                    manifest["journal_error_recorded"] = True
                    save_manifest(path, manifest)
                last_journal = now
            variety_offset, variety_lines = variety_log_events(variety_offset)
            if variety_lines:
                append_json(events_path, {"type": "variety_log_events", "timestamp": now_iso(), "lines": variety_lines})

            previous_stat = current_stat
            previous_proc = current_proc
            previous_vm = current_vm
            previous_power = current_power
            previous_wallpaper = current_wallpaper
            previous_stat = current_stat
            previous_disks = disk_ref["diskstats"]
            previous_sample_time = now

            if samples_path.stat().st_size >= MAX_LOG_BYTES:
                manifest.update({"status": "stopped", "finished_at": now_iso(), "finish_reason": "2 GiB sample log safety limit reached"})
                save_manifest(path, manifest)
                append_json(events_path, {"type": "recorder_stopped", "timestamp": now_iso(), "reason": manifest["finish_reason"]})
                break
            if time.monotonic() - last_fsync >= 60:
                try:
                    sample_file.flush()
                    os.fsync(sample_file.fileno())
                except OSError:
                    pass
                last_fsync = time.monotonic()
            remaining = SAMPLE_SECONDS - (time.monotonic() - tick_start)
            if remaining > 0:
                time.sleep(remaining)

        if STOP and manifest.get("status") == "recording":
            manifest.update({"status": "paused", "paused_at": now_iso(), "pause_reason": "service stopped or user requested stop"})
            save_manifest(path, manifest)
            append_json(events_path, {"type": "recorder_paused", "timestamp": now_iso()})
        sample_file.flush()
        sample_file.close()
        return 0


def status() -> int:
    path = session_dir()
    if not path:
        print("No active stutter-watch session. Start the user service to create one.")
        return 1
    manifest = load_manifest(path)
    print(json.dumps({"session_dir": str(path), "manifest": manifest}, indent=2))
    return 0


def notify(summary: str, body: str = "", urgency: str = "low") -> None:
    if shutil.which("notify-send"):
        command(["notify-send", "-a", "stutter-watch", "-u", urgency, "-t", "4000", summary, body], 3)


def diagnostics() -> dict:
    """Everything the manual checklist asked for, captured at the moment of a mark."""
    before = process_snapshot()
    t0 = time.monotonic()
    time.sleep(1.0)
    after = process_snapshot()
    dt = time.monotonic() - t0
    active, _ = hyprctl_json(["activewindow"])
    blur, _ = hyprctl_json(["getoption", "decoration:blur:enabled"])
    probe_state = None
    try:
        probe_state = json.loads(PROBE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        pass
    return {
        "buddyinfo": buddyinfo(),
        "memory_bytes": parse_key_values("/proc/meminfo"),
        "vmstat_counters": vmstat(),
        "pressure": psi(),
        "swap": swap_state(),
        "desktop_procs": desktop_procs(after, before, dt),
        "process_top_1s": process_top(after, before, dt, limit=8),
        "hyprland_layout": hyprland_layout(),
        # Class/workspace only; window titles are not recorded.
        "active_window": {k: (active or {}).get(k) for k in ("class", "fullscreen", "floating", "xwayland")} | {"workspace": ((active or {}).get("workspace") or {}).get("name")} if isinstance(active, dict) else None,
        "blur_enabled": bool(blur.get("bool", blur.get("int"))) if isinstance(blur, dict) else None,
        "probe_active": probe_state,
        "game_active": game_active(),
        "uptime_seconds": float((read_text("/proc/uptime").split() or ["0"])[0]),
    }


def mark(text: str) -> int:
    path = session_dir()
    if not path:
        print("No active session; start stutter-watch first.", file=sys.stderr)
        notify("stutter-watch: no active session", "Mark not recorded.", "normal")
        return 1
    manifest = load_manifest(path)
    if manifest.get("status") == "complete":
        print("The current seven-day session is complete.", file=sys.stderr)
        notify("stutter-watch: session complete", "Run 'stutter-watch new-session' to record again.", "normal")
        return 1
    text = " ".join(text.split())[:300]
    stamp, unix = now_iso(), time.time()  # timestamp of the keypress, before the 1 s measurement
    diag = diagnostics()
    append_json(path / "events.jsonl", {"type": "user_mark", "timestamp": stamp, "unix_time": unix, "text": text or "stutter noticed", "diagnostics": diag})
    frag = (diag.get("buddyinfo") or {}).get("normal_free_mib_order_ge_9")
    notify("Stutter marked", f"Saved diagnostics. ≥2 MiB free blocks: {frag} MiB" + ("  (blur probe active)" if diag.get("probe_active") else ""))
    print(f"Recorded mark with diagnostics in {path / 'events.jsonl'}")
    return 0


def set_blur(enabled: bool) -> bool:
    rc, out, _ = hyprctl(["eval", f"hl.config({{ decoration = {{ blur = {{ enabled = {'true' if enabled else 'false'} }} }} }})"])
    return rc == 0 and out.strip() == "ok"


def log_event(obj: dict) -> None:
    path = session_dir()
    if path:
        append_json(path / "events.jsonl", obj)


def restore_stale_probe(events_path: Path | None = None) -> None:
    try:
        state = json.loads(PROBE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return
    if time.time() - state.get("started_unix", 0) < PROBE_SECONDS + 30:
        return
    if set_blur(True):
        PROBE_FILE.unlink(missing_ok=True)
        obj = {"type": "probe_ended", "timestamp": now_iso(), "variable": "blur", "reason": "restored by recorder (probe process did not finish)"}
        append_json(events_path, obj) if events_path else log_event(obj)


def probe() -> int:
    """Disable blur for PROBE_SECONDS, then restore. Press again to cancel early.

    Marks made while the probe is active say whether stutter persists without
    blur; the analysis compares mark rates with and without the probe.
    """
    if PROBE_FILE.exists():
        PROBE_FILE.unlink(missing_ok=True)  # the running probe sees this and restores
        notify("Blur probe cancelled", "Blur restored.")
        return 0
    blur, err = hyprctl_json(["getoption", "decoration:blur:enabled"])
    if not isinstance(blur, dict):
        notify("Blur probe failed", f"hyprctl: {err}", "normal")
        return 1
    if not bool(blur.get("bool", blur.get("int"))):
        notify("Blur probe skipped", "Blur is already disabled.")
        return 0
    started = time.time()
    STATE.mkdir(parents=True, exist_ok=True)
    PROBE_FILE.write_text(json.dumps({"started_unix": started, "variable": "blur", "pid": os.getpid()}))
    if not set_blur(False):
        PROBE_FILE.unlink(missing_ok=True)
        notify("Blur probe failed", "Could not disable blur.", "normal")
        return 1
    log_event({"type": "probe_started", "timestamp": now_iso(), "variable": "blur", "seconds": PROBE_SECONDS})
    notify("Blur OFF for 2 minutes", "Move between windows. Still stuttering? Press Super+Shift+M.\nSuper+Shift+B again cancels.", "normal")
    reason = "timer elapsed"
    while time.time() - started < PROBE_SECONDS:
        time.sleep(1)
        if not PROBE_FILE.exists():
            reason = "cancelled by user"
            break
    set_blur(True)
    PROBE_FILE.unlink(missing_ok=True)
    log_event({"type": "probe_ended", "timestamp": now_iso(), "variable": "blur", "reason": reason})
    if reason == "timer elapsed":
        notify("Blur restored", "Probe finished.")
    return 0


def new_session() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    service = shutil.which("systemctl")
    if service:
        command([service, "--user", "stop", "stutter-watch.service"], 10)
    path = start_session()
    print(f"Created new seven-day session: {path}")
    if service:
        rc, out, err = command([service, "--user", "start", "stutter-watch.service"], 10)
        if rc != 0:
            print(err or out or "Could not start the user service", file=sys.stderr)
            return 1
    return 0


def bundle() -> int:
    path = session_dir()
    if not path:
        print("No capture session found.", file=sys.stderr)
        return 1
    manifest = load_manifest(path)
    if manifest.get("status") == "recording":
        print("Stop the recorder first so the bundle is consistent: systemctl --user stop stutter-watch.service", file=sys.stderr)
        return 1
    target = SESSIONS / f"{path.name}.tar.gz"
    try:
        with tarfile.open(target, "w:gz", compresslevel=6) as archive:
            archive.add(path, arcname=path.name)
            if NOTES.is_file():
                archive.add(NOTES, arcname=f"{path.name}/NOTES.md")
    except (OSError, tarfile.TarError) as exc:
        print(f"Could not create bundle: {exc}", file=sys.stderr)
        return 1
    print(target)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Record low-overhead system telemetry for a seven-day stutter investigation.")
    sub = parser.add_subparsers(dest="action")
    sub.add_parser("run", help=argparse.SUPPRESS)
    sub.add_parser("status", help="Show the current capture session")
    p_mark = sub.add_parser("mark", help="Record the time you notice a stutter")
    p_mark.add_argument("text", nargs="*", help="Optional short note (avoid private content)")
    sub.add_parser("probe", help="Disable Hyprland blur for 2 minutes (run again to cancel)")
    sub.add_parser("review", help="Review suspected stutters from the last game session")
    p_prompts = sub.add_parser("prompts", help="Turn detector pop-ups on/off (detections are always logged)")
    p_prompts.add_argument("state", nargs="?", choices=["on", "off", "status"], default="status")
    sub.add_parser("new-session", help="Start a fresh seven-day session")
    sub.add_parser("bundle", help="Compress a stopped or completed capture for analysis")
    args = parser.parse_args()
    action = args.action or "run"
    if action == "run":
        return run_recorder()
    if action == "status":
        return status()
    if action == "mark":
        return mark(" ".join(args.text))
    if action == "probe":
        return probe()
    if action == "review":
        return review_command()
    if action == "prompts":
        return prompts_command(args.state)
    if action == "new-session":
        return new_session()
    if action == "bundle":
        return bundle()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
