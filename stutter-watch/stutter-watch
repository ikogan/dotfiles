    keep = ("name", "make", "model", "width", "height", "refreshRate", "scale", "transform", "focused", "dpmsStatus", "vrr", "disabled", "currentFormat")
    return [{k: mon.get(k) for k in keep if k in mon} for mon in value if isinstance(mon, dict)], None


def monitor_configuration(monitors: list | None) -> list | None:
    if monitors is None:
        return None
    return [{key: value for key, value in mon.items() if key != "focused"} for mon in monitors]


def gpu_state() -> tuple[dict | None, str | None]:
    exe = shutil.which("gputop")
    if not exe:
        return None, "gputop not installed"
    rc, out, err = command([exe, "-d", "0.2", "-n", "1"], 2.5)
    if rc != 0:
        return None, (err or out or f"gputop exited {rc}")[:300]
    out = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", out)
    devices = []
    current = None
    for line in out.splitlines():
        head = re.search(r"DRM minor\s+(\d+).*?Frequency\(MHz\)(.*)", line)
        if head:
            current = {"drm_minor": int(head.group(1)), "frequency": {}, "clients": []}
            for item in head.group(2).split():
                m = re.fullmatch(r"(GT\d+)-([\d.]+)/([\d.]+)", item)
                if m:
                    current["frequency"][m.group(1)] = {"current_mhz": float(m.group(2)), "reported_max_mhz": float(m.group(3))}
            devices.append(current)
            continue
        if current is None:
            continue
        row = re.match(r"^\s*(\d+)\s+\S+\s+\S+\s+\|\s*([\d.]+)%\s+\|\|\s*([\d.]+)%\s+\|\|\s*([\d.]+)%\s+\|\|\s*([\d.]+)%\s+\|\|\s*([\d.]+)%\s+\|\s*(.*?)\s*$", line)
        if row:
            client = {"pid": int(row.group(1)), "engines_pct": [float(row.group(i)) for i in range(2, 7)], "name": row.group(7).strip()[:80]}
            if any(client["engines_pct"]):
                current["clients"].append(client)
    for dev in devices:
        dev["clients"] = sorted(dev["clients"], key=lambda c: max(c["engines_pct"]), reverse=True)[:12]
    if not devices:
        return None, "gputop output did not contain device data"
    return devices, None


def service_state() -> dict:
    result = {}
    for scope in ("system", "user"):
        args = ["systemctl"] + (["--user"] if scope == "user" else []) + ["list-units", "--type=service", "--state=running", "--no-legend", "--no-pager"]
        rc, out, _ = command(args, 5)
        result[scope] = sorted(line.split()[0] for line in out.splitlines() if line.split()) if rc == 0 else None
    failed = {}
    timers = {}
    for scope in ("system", "user"):
        args = ["systemctl"] + (["--user"] if scope == "user" else []) + ["--failed", "--no-legend", "--no-pager"]
        rc, out, _ = command(args, 5)
        failed[scope] = sorted(unit_names(out)) if rc == 0 else None
        args = ["systemctl"] + (["--user"] if scope == "user" else []) + ["list-timers", "--all", "--no-legend", "--no-pager"]
        rc, out, _ = command(args, 5)
        timers[scope] = [line.strip() for line in out.splitlines() if line.strip()] if rc == 0 else None
    return {"running": result, "failed": failed, "timers": timers}


def btrfs_stats() -> dict:
    rc, out, err = command(["btrfs", "device", "stats", "/"], 5)
    stats = {}
    if rc == 0:
        for line in out.splitlines():
            m = re.match(r"\[(.*?)\]\.(\w+)\s+(\d+)", line)
            if m:
                stats[m.group(2)] = int(m.group(3))
    return {"device_stats": stats, "error": err[:200] if rc else None}


def btrfs_usage() -> str | None:
    rc, out, err = command(["btrfs", "filesystem", "usage", "-b", "/"], 8)
    text = out + (("\n" if out else "") + err if err else "")
    return text[:8000] if text else None


def scrub_relevant(text: str) -> bool:
    return bool(re.search(r"nvme|btrfs|\bxe\b|\bdrm\b|i915|gpu|oom|thermal|thrott|watchdog|sched_ext|intel_pstate|blk_update|I/O error|firmware|microcode|hung task", text, re.I))


def kernel_events(since: float) -> tuple[list[str], str | None]:
    if not shutil.which("journalctl"):
        return [], "journalctl not installed"
    rc, out, err = command(["journalctl", "-k", "--since", f"@{max(0, since - 1):.3f}", "--no-pager", "-o", "short-iso"], 5)
    if rc != 0:
        return [], (err or f"journalctl exited {rc}")[:300]
    lines = []
    for line in out.splitlines():
        if scrub_relevant(line):
            line = line.replace(str(HOME), "$HOME")
            lines.append(line[:500])
    return lines[-100:], None


def variety_log_events(offset: int | None) -> tuple[int | None, list[str]]:
    path = HOME / ".config/variety/variety.log"
    try:
        size = path.stat().st_size
        if offset is None or size < offset:
            return size, []
        with path.open("r", errors="replace") as f:
            f.seek(offset)
            lines = f.read(256 * 1024).splitlines()
        keep = []
        for line in lines:
            if re.search(r"wallpaper|change|error|warning|failed", line, re.I):
                keep.append(line.replace(str(HOME), "$HOME")[:400])
        return path.stat().st_size, keep[-30:]
    except OSError:
        return None, []


def parse_key_values(path: str) -> dict:
    result = {}
    try:
        for line in Path(path).read_text().splitlines():
            fields = line.split()
            # /proc/meminfo keys end in ':' (e.g. "MemTotal:").
            key = fields[0].rstrip(":") if fields else ""
            if key in ("MemTotal", "MemFree", "MemAvailable", "Buffers", "Cached", "SwapCached", "SwapTotal", "SwapFree", "Dirty", "Writeback", "Slab", "SReclaimable", "SUnreclaim", "AnonPages", "Mapped", "Shmem", "KReclaimable", "AnonHugePages", "PageTables") and len(fields) >= 2:
                result[key] = int(fields[1]) * (1024 if len(fields) > 2 and fields[2] == "kB" else 1)
    except (OSError, ValueError):
        pass
    return result


def swap_state() -> list:
    rows = []
    try:
        for line in Path("/proc/swaps").read_text().splitlines()[1:]:
            fields = line.split()
            if len(fields) >= 5:
                rows.append({"name": fields[0], "type": fields[1], "size_kib": int(fields[2]), "used_kib": int(fields[3]), "priority": int(fields[4])})
    except (OSError, ValueError):
        pass
    return rows


def sample(prev_disks: dict | None, prev_stat: dict | None, prev_time: float | None, prev_proc: dict | None, prev_vm: dict | None, prev_power: dict | None, prev_wallpaper: dict | None, now: float, gpu: dict | None, monitor: dict | None, btrfs: dict | None, layout: dict | None = None, gaming: bool = False) -> tuple[dict, dict, dict, dict, dict, dict, dict]:
    dt = max(0.001, now - prev_time) if prev_time else SAMPLE_SECONDS
    stat = parse_proc_stat()
    procs = process_snapshot()
    vms = vmstat()
    power = cpu_power_state()
    wallpaper = wallpaper_state()
    current_disks = diskstats()
    cpu_frequency_khz = {
        name: values.get("scaling_cur_freq")
        for name, values in power.get("policies", {}).items()
        if values.get("scaling_cur_freq") is not None
    }
    recorded_power = {
        "power_profile": power.get("power_profile"),
        "policies": {
            name: {key: values.get(key) for key in ("scaling_driver", "scaling_governor", "energy_performance_preference", "scaling_min_freq", "scaling_max_freq") if key in values}
            for name, values in power.get("policies", {}).items()
        },
        "intel_pstate": power.get("intel_pstate", {}),
        "sched_ext": power.get("sched_ext", {}),
    }
    load = read_text("/proc/loadavg").split()
    try:
        uptime = float(read_text("/proc/uptime").split()[0])
    except (ValueError, IndexError):
        uptime = None
    filesystems = {path: statvfs(path) for path in ("/", "/home", "/var/cache", "/var/log", "/var/tmp")}
    sample_data = {
        "type": "sample",
        "timestamp": now_iso(),
        "unix_time": now,
        "monotonic_seconds": time.monotonic(),
        "boot_id": read_text("/proc/sys/kernel/random/boot_id"),
        "uptime_seconds": uptime,
        "sample_interval_seconds": round(dt, 3),
        "loadavg": load[:3],
        "cpu_pct": cpu_percentages(stat, prev_stat),
        "cpu_counters": stat["misc"],
        "memory_bytes": parse_key_values("/proc/meminfo"),
        "swap": swap_state(),
        "vmstat_counters": vms,
        "pressure": psi(),
        "process_top": process_top(procs, prev_proc, dt),
        "process_top_rss": process_top_rss(procs),
        "disk_rates": disk_rates(current_disks, prev_disks, dt),
        "filesystems": filesystems,
        "zram": zram_stats(),
        "sensors_raw": sensor_values(),
        "nvme_sysfs": nvme_sysfs(),
        "cpu_frequency_khz": cpu_frequency_khz,
        "power_state": recorded_power,
        "kernel_tunables": kernel_tunables(),
        "battery": battery_state(),
        "wallpaper": wallpaper,
        "gpu": gpu,
        "hyprland_monitors": monitor,
        "btrfs_device_stats": btrfs,
        "buddyinfo": buddyinfo(),
        "desktop_procs": desktop_procs(procs, prev_proc, dt),
        "hyprland_layout": layout,
        "game_active": gaming,
    }
    if prev_vm:
        sample_data["vmstat_delta"] = {key: max(0, val - prev_vm.get(key, val)) for key, val in vms.items()}
    if prev_power:
        old_rapl = prev_power.get("rapl_energy_uj", {})
        rapl_watts = {}
        for name, val in power.get("rapl_energy_uj", {}).items():
            old = old_rapl.get(name, {}).get("energy_uj")
            if old is not None and val["energy_uj"] >= old:
                rapl_watts[name] = round((val["energy_uj"] - old) / 1e6 / dt, 2)
            elif old is not None and val.get("max_range_uj"):
                diff = val["energy_uj"] + val["max_range_uj"] - old
                rapl_watts[name] = round(diff / 1e6 / dt, 2)
        sample_data["rapl_watts"] = rapl_watts
    if prev_wallpaper is not None and wallpaper != prev_wallpaper:
        sample_data["wallpaper_changed"] = True
    return sample_data, {"diskstats": current_disks}, stat, procs, vms, power, wallpaper


