[Unit]
Description=Kubernetes MCP Server
Documentation=https://github.com/containers/kubernetes-mcp-server
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/kubernetes-mcp-server --config %h/.config/mcp/kubernetes-mcp-server.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kubernetes-mcp-server

[Install]
WantedBy=default.target
