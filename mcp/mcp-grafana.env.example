# Grafana MCP server environment (consumed by the mcp-grafana systemd unit).
#
# This is a reference of the format only. setup-mcp generates the real file at
# ~/.config/mcp/mcp-grafana.env (mode 0600) from environment variables or an
# interactive gum prompt. Edit that file (not this one) to change the
# credentials.
GRAFANA_URL=https://grafana.example.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=
